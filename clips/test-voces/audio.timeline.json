        ]
      ]
    },
    {
      "speaker": "ANA",
      "scene": "ana_despedida",
      "start": 133.35216666666668,
      "end": 138.66091666666668,
      "text": "Y tú que estás viendo este desastre, suscríbete. Porque esta familia todavía tiene muchos trapos sucios que sacar.",
      "speech_intervals": [
        [
          133.35216666666668,
