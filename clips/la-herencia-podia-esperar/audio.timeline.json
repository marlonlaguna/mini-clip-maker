        ]
      ]
    },
    {
      "speaker": "ANA",
      "scene": "la_herencia",
      "start": 119.187125,
      "end": 126.10379166666667,
      "text": "Queríamos quedarnos con su casa. Ahora no puedo pasar frente a ella sin recordar la silla vacía que dejó para mi esposo.",
