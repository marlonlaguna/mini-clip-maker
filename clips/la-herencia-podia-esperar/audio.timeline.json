  "blocks": [
    {
      "speaker": "ANA",
      "scene": "la_visita",
      "start": 0.0,
      "end": 7.055958333333334,
      "text": "Fuimos a cenar con mi padre. Él pensaba que queríamos pasar tiempo juntos. Nosotros queríamos su casa.",
      "speech_intervals": [
        [
          0.3,
          1.8800000000000001
        ],
        [
          2.26,
          4.96
        ],
        [
          5.340000000000001,
          6.8
        ]
      ]
    },
    {
      "speaker": "JHON",
      "scene": "el_plan",
      "start": 7.455958333333333,
      "end": 14.736375,
      "text": "Sonríe y deja que coma. Cuando heredes, vendemos esta casa y desaparecemos.",
      "speech_intervals": [
        [
          7.955958333333333,
          10.055958333333333
        ],
        [
          10.355958333333334,
          11.255958333333332
        ],
        [
          11.675958333333334,
          12.935958333333334
        ],
        [
          13.115958333333333,
          14.335958333333334
        ]
      ]
    },
    {
      "speaker": "ANA",
      "scene": "la_duda",
      "start": 15.036375,
      "end": 17.072333333333333,
      "text": "Sigue siendo mi padre, Jhon.",
      "speech_intervals": [
        [
          15.376375,
          16.756375
        ]
      ]
    },
    {
      "speaker": "JHON",
      "scene": "demasiado_tarde",
      "start": 17.472333333333335,
      "end": 22.351666666666667,
      "text": "Debiste pensarlo antes de traer la manzana envenenada.",
      "speech_intervals": [
        [
          17.812333333333335,
          19.112333333333336
        ],
        [
          19.372333333333334,
          22.152333333333335
        ]
      ]
    },
    {
      "speaker": "PAUL",
      "scene": "bienvenida",
      "start": 22.751666666666665,
      "end": 30.751875,
      "text": "Qué sorpresa. Hacía meses que no venían los dos.",
      "speech_intervals": [
        [
          23.171666666666667,
          23.271666666666665
        ],
        [
          23.371666666666666,
          23.711666666666666
        ],
        [
          23.811666666666664,
          24.151666666666664
        ],
        [
          24.251666666666665,
          24.431666666666665
        ],
        [
          25.051666666666666,
          25.551666666666666
        ],
        [
          25.691666666666666,
          25.871666666666666
        ],
        [
          26.251666666666665,
          27.231666666666666
        ],
        [
          27.291666666666664,
          27.551666666666666
        ],
        [
          27.611666666666665,
          27.791666666666664
        ],
        [
          27.931666666666665,
          30.431666666666665
        ]
      ]
    },
    {
      "speaker": "ANA",
      "scene": "el_regalo",
      "start": 31.051875,
      "end": 35.710375,
      "text": "Te trajimos fruta, papá. Elegí una manzana especialmente para ti.",
      "speech_intervals": [
        [
          31.271874999999998,
          32.651875
        ],
        [
          32.911875,
          35.451875
        ]
      ]
    },
    {
      "speaker": "ANA",
      "scene": "su_mirada",
      "start": 36.110375,
      "end": 43.091458333333335,
      "text": "Mi padre miró la manzana. Después nos miró a nosotros. No dijo nada, pero dejó de sonreír.",
      "speech_intervals": [
        [
          36.450375,
          37.990375
        ],
        [
          38.370374999999996,
          40.110375
        ],
        [
          40.490375,
          41.390375
        ],
        [
          41.570375,
          41.910374999999995
        ],
        [
          41.970375,
          42.750375
        ]
      ]
    },
    {
      "speaker": "PAUL",
      "scene": "a_la_mesa",
      "start": 43.591458333333335,
      "end": 49.198125,
      "text": "Siéntense. Voy a servir el postre. También tengo manzanas para ustedes.",
      "speech_intervals": [
        [
          44.29145833333334,
          45.19145833333334
        ],
        [
          45.491458333333334,
          46.671458333333334
        ],
        [
          46.97145833333334,
          48.631458333333335
        ]
      ]
    },
    {
      "speaker": "ANA",
      "scene": "la_senal",
      "start": 53.598125,
      "end": 61.823458333333335,
      "text": "Jhon empezó a comer para disimular. Bajo la mesa me apretó la mano. Creía que todo estaba saliendo como habíamos planeado.",
      "speech_intervals": [
        [
          53.778125,
          55.878125000000004
        ],
        [
          56.25812500000001,
          58.198125000000005
        ],
        [
          58.698125000000005,
          61.598125
        ]
      ]
    },
    {
      "speaker": "JHON",
      "scene": "no_pruebas",
      "start": 62.22345833333333,
      "end": 64.33145833333333,
      "text": "¿No vas a probar la tuya, Paul?",
      "speech_intervals": [
        [
          62.56345833333334,
          64.02345833333334
        ]
      ]
    },
    {
      "speaker": "PAUL",
      "scene": "la_pregunta",
      "start": 64.73145833333334,
      "end": 69.60445833333333,
      "text": "Antes quisiera saber cuánto creen que vale esta casa.",
      "speech_intervals": [
        [
          64.99145833333334,
          66.57145833333334
        ],
        [
          66.91145833333334,
          68.77145833333334
        ]
      ]
    },
    {
      "speaker": "PAUL",
      "scene": "nos_escucho",
      "start": 71.60445833333333,
      "end": 83.67291666666667,
      "text": "La ventana estaba abierta. Los escuché antes de que tocaran la puerta. Hasta oí lo de desaparecer después de venderla.",
      "speech_intervals": [
        [
          72.06445833333332,
          73.68445833333332
        ],
        [
          73.74445833333333,
          74.00445833333333
        ],
