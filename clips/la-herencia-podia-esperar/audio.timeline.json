        ]
      ]
    },
    {
      "speaker": "ANA",
      "scene": "delante_de_mi",
      "start": 101.24075,
      "end": 109.75120833333334,
      "text": "Mi padre no se movió. Jhon murió delante de mí. Cuando intenté acercarme, papá me sujetó del brazo y me obligó a mirarlo.",
      "speech_intervals": [
        [
          101.66075000000001,
          103.00075000000001
        ],
        [
          103.54075,
          104.80075000000001
        ],
        [
