        ]
      ]
    },
    {
      "speaker": "ANA",
      "scene": "la_suplica",
      "start": 97.27808333333333,
      "end": 100.84075,
      "text": "¡Papá, llama a una ambulancia! ¡Por favor!",
      "speech_intervals": [
        [
          97.45808333333333,
          97.63808333333333
        ],
        [
          97.69808333333333,
          98.03808333333333
