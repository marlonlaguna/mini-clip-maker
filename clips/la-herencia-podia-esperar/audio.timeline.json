    },
    {
      "speaker": "JHON",
      "scene": "algo_va_mal",
      "start": 84.07291666666667,
      "end": 87.13333333333334,
      "text": "Ana... no me siento bien.",
      "speech_intervals": [
        [
          84.37291666666667,
          84.95291666666667
        ],
        [
          85.13291666666667,
          86.67291666666667
