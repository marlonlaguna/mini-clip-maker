        ],
        [
          108.18075,
          109.40075
        ]
      ]
    },
    {
      "speaker": "PAUL",
      "scene": "la_advertencia",
      "start": 110.25120833333334,
      "end": 118.687125,
      "text": "Esta vez puedes salir de mi casa, hija. Pero no vuelvas a intentar matarme. No habrá una segunda advertencia.",
      "speech_intervals": [
        [
          110.67120833333334,
          111.41120833333333
        ],
