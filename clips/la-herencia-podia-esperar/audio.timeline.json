    },
    {
      "speaker": "PAUL",
      "scene": "el_intercambio",
      "start": 87.43333333333334,
      "end": 94.77808333333333,
      "text": "Cambié las manzanas al servirlas. La que acabas de comerte era la que trajeron para mí.",
      "speech_intervals": [
        [
          88.53333333333333,
          90.35333333333334
        ],
        [
          90.89333333333333,
          92.19333333333334
