    },
    {
      "speaker": "TOMY",
      "scene": "llamada_hermana",
      "start": 75.09645833333333,
      "end": 84.84225,
      "text": "A la mañana siguiente llamé a mi hermana y le conté todo. Se quedó callada. Después me preguntó algo que me hizo sentir un escalofrío.",
      "speech_intervals": [
        [
          76.39645833333333,
