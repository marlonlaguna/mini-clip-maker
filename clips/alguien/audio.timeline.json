      "speaker": "TOMY",
      "scene": "ultimo_susurro",
      "start": 198.35933333333332,
      "end": 207.45208333333332,
      "text": "Después de que las dos voces dejan de hablar, se escucha una puerta muy cerca del teléfono. Y alguien comienza a susurrar mi nombre.",
      "speech_intervals": [
        [
          198.81933333333333,
