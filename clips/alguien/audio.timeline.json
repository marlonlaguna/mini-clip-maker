    {
      "speaker": "TOMY",
      "scene": "vive_lejos",
      "start": 187.740625,
      "end": 197.55933333333334,
      "text": "Mi hermana vive en otra ciudad, a cientos de kilómetros. Pero todavía no le he contado lo peor. Hay algo más al final de la grabación.",
