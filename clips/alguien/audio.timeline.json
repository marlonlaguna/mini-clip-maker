          62.52291666666667,
          63.70291666666667
        ],
        [
          63.80291666666667,
          64.74291666666667
        ]
      ]
    },
    {
      "speaker": "TOMY",
      "scene": "el_vaso",
      "start": 65.28808333333333,
      "end": 74.59645833333333,
      "text": "Pero había algo extraño. Un vaso lleno de agua sobre la mesa. Estaba seguro de no haberlo dejado ahí.",
      "speech_intervals": [
        [
          65.38808333333333,
          66.84808333333334
        ],
