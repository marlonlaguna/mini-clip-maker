  "blocks": [
    {
      "speaker": "TOMY",
      "scene": "advertencia",
      "start": 0.0,
      "end": 8.882,
      "text": "Anoche grabé mi habitación mientras dormía. A las tres de la mañana, escuché mi propia voz discutiendo con alguien. Pero yo vivo solo.",
      "speech_intervals": [
        [
          0.45999999999999996,
          2.68
        ],
        [
          3.02,
          4.08
        ],
        [
          4.180000000000001,
          5.28
        ],
        [
          5.420000000000001,
          6.5200000000000005
        ],
        [
          6.58,
          7.08
        ],
        [
          7.420000000000001,
          8.44
        ]
      ]
    },
    {
      "speaker": "TOMY",
      "scene": "presentacion",
      "start": 9.482,
      "end": 19.957583333333332,
      "text": "Me llamo Tomy. Llevo varios meses viviendo solo en esta casa. Nunca creí en fantasmas, hasta que empecé a escuchar pasos por el pasillo.",
      "speech_intervals": [
        [
          9.902,
          10.402
        ],
        [
          10.501999999999999,
          10.921999999999999
        ],
        [
          11.341999999999999,
          14.041999999999998
        ],
        [
          14.501999999999999,
          16.241999999999997
        ],
        [
          16.742,
          18.201999999999998
        ],
        [
          18.262,
          19.561999999999998
        ]
      ]
    },
    {
      "speaker": "TOMY",
      "scene": "primeros_pasos",
      "start": 20.257583333333333,
      "end": 29.276125,
      "text": "Todas las noches era lo mismo. Pasos lentos, como si alguien caminara descalzo. Pensé que eran mis vecinos y traté de ignorarlo.",
      "speech_intervals": [
        [
          20.517583333333334,
          22.17758333333333
        ],
        [
          22.637583333333332,
          25.297583333333332
        ],
        [
          25.677583333333335,
          27.17758333333333
        ],
        [
          27.277583333333332,
          28.85758333333333
        ]
      ]
    },
    {
      "speaker": "TOMY",
      "scene": "dormir",
      "start": 29.676125,
      "end": 36.3035,
      "text": "Pero ayer, a las tres de la mañana, me despertó el sonido de una puerta abriéndose en la cocina.",
      "speech_intervals": [
        [
          30.096125,
          30.676125
        ],
        [
          31.096125,
          32.356125
        ],
        [
          32.496125,
          34.036125
        ],
        [
          34.136125,
          35.996125
        ]
      ]
    },
    {
      "speaker": "TOMY",
      "scene": "ruido_cocina",
      "start": 36.8035,
      "end": 44.447541666666666,
      "text": "Después escuché pasos, el ruido de un vaso sobre una mesa y un cajón cerrándose. Había alguien dentro de mi casa.",
      "speech_intervals": [
        [
          36.9835,
          38.2835
        ],
        [
          38.463499999999996,
          40.3635
        ],
        [
          40.463499999999996,
          41.9235
        ],
        [
          42.2635,
          44.0035
        ]
      ]
    },
    {
      "speaker": "TOMY",
      "scene": "levantarme",
      "start": 44.947541666666666,
      "end": 54.62291666666667,
      "text": "Me quedé inmóvil unos segundos. Recordé que había cerrado todas las puertas. Y que absolutamente nadie más tenía llaves.",
      "speech_intervals": [
        [
          45.40754166666667,
          47.46754166666667
        ],
        [
          47.887541666666664,
          49.387541666666664
        ],
        [
          49.447541666666666,
          49.987541666666665
        ],
        [
