    {
      "speaker": "TOMY",
      "scene": "pregunta_hermana",
      "start": 85.24225,
      "end": 96.372875,
      "text": "Me preguntó si también escuchaba pasos en el pasillo. No entendía cómo podía saberlo. Entonces me contó algo que llevaba años ocultándome.",
