          50.50754166666667
        ],
        [
          50.807541666666665,
          53.22754166666667
        ],
        [
          53.32754166666667,
          54.347541666666665
        ]
      ]
    },
    {
      "speaker": "TOMY",
      "scene": "revisar",
      "start": 55.02291666666667,
      "end": 64.98808333333334,
      "text": "Salí de mi habitación y revisé toda la casa. No había nadie. Las ventanas estaban cerradas y la puerta principal seguía con llave.",
      "speech_intervals": [
        [
          55.48291666666667,
          57.54291666666667
        ],
        [
          57.642916666666665,
          58.54291666666667
        ],
        [
          59.242916666666666,
          60.34291666666667
